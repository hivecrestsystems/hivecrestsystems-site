---
// Primary logo lockup (crest cell + "hivecrest" + "SYSTEMS") for the dark header.
interface Props {
  href: string;
}
const { href } = Astro.props;
---
<a href={href} aria-label="Hivecrest Systems home" class="brand-link">
<img src="/assets/hivecrest-logo-on-dark.svg" alt="" width="264" height="52" class="brand-logo">
</a>
