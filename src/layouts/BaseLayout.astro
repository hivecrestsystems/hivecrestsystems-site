---
import '../styles/site.css';
// Every font weight appears above the fold, so all five are preloaded.
import interRegular from '../../brand/fonts/inter-latin-400-normal.woff2?url';
import interMedium from '../../brand/fonts/inter-latin-500-normal.woff2?url';
import interSemibold from '../../brand/fonts/inter-latin-600-normal.woff2?url';
import monoMedium from '../../brand/fonts/jetbrains-mono-latin-500-normal.woff2?url';
import monoExtraBold from '../../brand/fonts/jetbrains-mono-latin-800-normal.woff2?url';

const fontPreloads = [monoExtraBold, monoMedium, interRegular, interMedium, interSemibold];

interface Props {
  /** Page title, also used for og:title. */
  title: string;
  /** Meta description, also used for og:description. */
  description: string;
  /** Site-relative path of the page, e.g. "/" or "/privacy.html". */
  path: string;
}

const { title, description, path } = Astro.props;
const canonical = new URL(path, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<!-- Marks that scripts run, so the phone menu only hides the links when its button works. -->
<script is:inline>document.documentElement.classList.add('js');</script>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Hivecrest Systems">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content="https://hivecrestsystems.com/assets/og-image.png">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#141416">
<link rel="icon" href="assets/favicon.ico" sizes="any">
<link rel="icon" href="assets/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="assets/apple-touch-icon.png">
{fontPreloads.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
<slot name="head" />
</head>
<body>
<slot />
</body>
</html>
