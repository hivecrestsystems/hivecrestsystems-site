---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Hivecrest Systems | Software, web, cloud and IT consulting"
  description="Hivecrest Systems designs, builds and supports the websites, software, cloud and automation that businesses and public agencies run on."
  path="/"
>
<Fragment slot="head">
<style is:inline>
body{margin:0}
a{color:#18181B}a:hover{color:#5F5E5A}
@keyframes hc-blink{50%{opacity:0}}
.hc-cursor{animation:hc-blink 1s step-end infinite}
@media (prefers-reduced-motion: reduce){.hc-cursor{animation:none}}
[hidden]{display:none !important}
</style>
</Fragment>
<div style="background: #F6F5F1; color: #18181B; font-family: Inter, system-ui, sans-serif">

<header style="background: #141416; color: #EDEBE4; position: relative; overflow: hidden">
<svg viewBox="0 0 100 100" aria-hidden="true" style="position: absolute; right: -80px; top: 60px; width: 620px; height: 620px; pointer-events: none">
<polygon points="40.00,10.80 47.97,15.40 47.97,24.60 40.00,29.20 32.03,24.60 32.03,15.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="57.32,10.80 65.29,15.40 65.29,24.60 57.32,29.20 49.35,24.60 49.35,15.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="74.64,10.80 82.61,15.40 82.61,24.60 74.64,29.20 66.67,24.60 66.67,15.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="31.34,25.80 39.31,30.40 39.31,39.60 31.34,44.20 23.37,39.60 23.37,30.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="48.66,25.80 56.63,30.40 56.63,39.60 48.66,44.20 40.69,39.60 40.69,30.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="83.30,25.80 91.27,30.40 91.27,39.60 83.30,44.20 75.33,39.60 75.33,30.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="40.00,40.80 47.97,45.40 47.97,54.60 40.00,59.20 32.03,54.60 32.03,45.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="57.32,40.80 65.29,45.40 65.29,54.60 57.32,59.20 49.35,54.60 49.35,45.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="74.64,40.80 82.61,45.40 82.61,54.60 74.64,59.20 66.67,54.60 66.67,45.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="91.96,40.80 99.93,45.40 99.93,54.60 91.96,59.20 83.99,54.60 83.99,45.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="48.66,55.80 56.63,60.40 56.63,69.60 48.66,74.20 40.69,69.60 40.69,60.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="65.98,55.80 73.95,60.40 73.95,69.60 65.98,74.20 58.01,69.60 58.01,60.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="83.30,55.80 91.27,60.40 91.27,69.60 83.30,74.20 75.33,69.60 75.33,60.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="57.32,70.80 65.29,75.40 65.29,84.60 57.32,89.20 49.35,84.60 49.35,75.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="74.64,70.80 82.61,75.40 82.61,84.60 74.64,89.20 66.67,84.60 66.67,75.40" fill="none" stroke="#34343A" stroke-width="0.35"></polygon>
<polygon points="65.98,25.80 73.95,30.40 73.95,39.60 65.98,44.20 58.01,39.60 58.01,30.40" fill="none" stroke="#E39A2B" stroke-width="0.6"></polygon>
</svg>

<div style="max-width: 1200px; margin: 0 auto; padding: 20px 32px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; position: relative">
<a href="#top" aria-label="Hivecrest Systems home" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #EDEBE4">
<svg viewBox="0 0 100 100" width="40" height="40" aria-hidden="true">
<polygon points="50,21.5 64.29,29.75 64.29,46.25 50,54.5 35.71,46.25 35.71,29.75" fill="#E39A2B"></polygon>
<polyline points="42.5,43 50,35.5 57.5,43" fill="none" stroke="#141416" stroke-width="3.6" stroke-linecap="square"></polyline>
<polygon points="34.41,48.5 48.7,56.75 48.7,73.25 34.41,81.5 20.12,73.25 20.12,56.75" fill="#EDEBE4"></polygon>
<polygon points="65.59,48.5 79.88,56.75 79.88,73.25 65.59,81.5 51.3,73.25 51.3,56.75" fill="#EDEBE4"></polygon>
</svg>
<span style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: 22px; letter-spacing: -0.5px">hivecrest</span>
</a>
<nav aria-label="Main" style="display: flex; flex-wrap: wrap; align-items: center; gap: 28px; font-size: 15px; font-weight: 500">
<a href="#services" style="color: #EDEBE4; text-decoration: none">Services</a>
<a href="#work" style="color: #EDEBE4; text-decoration: none">Work</a>
<a href="#government" style="color: #EDEBE4; text-decoration: none">Government</a>
<a href="#about" style="color: #EDEBE4; text-decoration: none">About</a>
<a href="#contact" style="display: inline-flex; align-items: center; min-height: 44px; padding: 0 18px; border-radius: 8px; background: #E39A2B; color: #18181B; font-weight: 600; text-decoration: none">Book a call</a>
</nav>
</div>

<section id="top" style="position: relative">
<div style="max-width: 1200px; margin: 0 auto; padding: 88px 32px 128px; display: flex; flex-direction: column; gap: 28px">
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; font-weight: 500; letter-spacing: 2px; color: #E39A2B">IT SERVICES · IT CONSULTING</p>
<h1 style="margin: 0; max-width: 900px; font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: clamp(40px, 5.4vw, 76px); line-height: 1.05; letter-spacing: -2px">Strong systems, built cell by cell.</h1>
<p aria-hidden="true" style="margin: 0; min-height: 1.5em; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: clamp(17px, 2vw, 24px); font-weight: 500; color: #EDEBE4"><span style="color: #E39A2B">$</span> hivecrest build <span id="typed" style="color: #E39A2B">websites that sell.</span><span class="hc-cursor" style="display: inline-block; width: 0.55em; height: 1.05em; margin-left: 2px; vertical-align: -0.15em; background: #E39A2B"></span></p>
<p style="margin: 0; max-width: 640px; font-size: 20px; line-height: 1.6; color: #C9C7BF">Hivecrest Systems designs, builds and supports the websites, software, cloud and automation that businesses and public agencies run on.</p>
<div style="display: flex; flex-wrap: wrap; gap: 16px; margin-top: 8px">
<a href="#contact" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 8px; background: #E39A2B; color: #18181B; font-size: 16px; font-weight: 600; text-decoration: none">Book a free consultation</a>
<a href="#services" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border-radius: 8px; border: 1px solid #5F5E5A; color: #EDEBE4; font-size: 16px; font-weight: 600; text-decoration: none">See what we build</a>
</div>
</div>
</section>
</header>

<section id="services" style="max-width: 1200px; margin: 0 auto; padding: 112px 32px; display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; gap: 16px">
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; font-weight: 500; letter-spacing: 2px; color: #5F5E5A">01 / SERVICES</p>
<h2 style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: clamp(30px, 3.4vw, 46px); letter-spacing: -1px; line-height: 1.1">What we build and run</h2>
<p style="margin: 0; max-width: 640px; font-size: 18px; line-height: 1.6; color: #5F5E5A">From a first website to a full system, every piece is built to fit with the rest.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px">

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Websites &amp; web apps</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">Fast, accessible websites and web applications that are easy to find and easy to update.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">Redesigns · Accessibility · SEO</p>
</article>

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">E-commerce &amp; Shopify</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">Shopify stores, theme customization and custom Shopify apps that make selling simpler.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">Store builds · Custom apps · Integrations</p>
</article>

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Mobile &amp; custom software</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">iOS and Android apps from one codebase, plus internal tools and dashboards for your team.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">React Native · Internal tools · APIs</p>
</article>

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">AI &amp; automation</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">Assistants and automated workflows that answer questions, book appointments and follow up for you.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">Chat assistants · Workflows · Integrations</p>
</article>

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Cloud &amp; IT consulting</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">Cloud setup, migrations and practical technical guidance for growing teams.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">AWS · Azure · Microsoft 365 · Google Workspace</p>
</article>

<article style="background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 12px; padding: 28px; display: flex; flex-direction: column; gap: 14px">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Care &amp; support plans</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #5F5E5A">Hosting, updates, monitoring and fixes on a predictable monthly plan.</p>
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 13px; font-weight: 500; color: #3A3A3F">Hosting · Monitoring · Maintenance</p>
</article>

</div>
</section>

<section style="background: #18181B; color: #EDEBE4">
<div style="max-width: 1200px; margin: 0 auto; padding: 104px 32px; display: flex; flex-direction: column; gap: 48px">
<div style="display: flex; flex-direction: column; gap: 16px">
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; font-weight: 500; letter-spacing: 2px; color: #E39A2B">02 / HOW WE WORK</p>
<h2 style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: clamp(30px, 3.4vw, 46px); letter-spacing: -1px; line-height: 1.1">Small cells. Strong structure.</h2>
<p style="margin: 0; max-width: 640px; font-size: 18px; line-height: 1.6; color: #C9C7BF">We work in short, visible steps, so you always know what's built, what's next and what it costs.</p>
</div>
<ol style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px">
<li style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #3A3A3F; padding-top: 20px">
<span style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 800; color: #E39A2B">01</span>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Discover</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #C9C7BF">We learn how your business runs and what's slowing it down.</p>
</li>
<li style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #3A3A3F; padding-top: 20px">
<span style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 800; color: #E39A2B">02</span>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Design</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #C9C7BF">We plan and prototype before writing code, while changes are still cheap.</p>
</li>
<li style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #3A3A3F; padding-top: 20px">
<span style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 800; color: #E39A2B">03</span>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Build</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #C9C7BF">We ship in short cycles you can review and test as we go.</p>
</li>
<li style="display: flex; flex-direction: column; gap: 10px; border-top: 1px solid #3A3A3F; padding-top: 20px">
<span style="font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 15px; font-weight: 800; color: #E39A2B">04</span>
<h3 style="margin: 0; font-size: 20px; font-weight: 600">Run</h3>
<p style="margin: 0; font-size: 16px; line-height: 1.6; color: #C9C7BF">We host, monitor and keep improving what we've built together.</p>
</li>
</ol>
</div>
</section>

<section id="work" style="max-width: 1200px; margin: 0 auto; padding: 112px 32px; display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start">
<div style="flex: 1 1 380px; display: flex; flex-direction: column; gap: 20px">
<p style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 14px; font-weight: 500; letter-spacing: 2px; color: #5F5E5A">03 / WORK</p>
<h2 style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-weight: 800; font-size: clamp(30px, 3.4vw, 46px); letter-spacing: -1px; line-height: 1.1">See work like yours</h2>
<p style="margin: 0; max-width: 520px; font-size: 18px; line-height: 1.6; color: #5F5E5A">Every project is built around one client's business, so instead of a generic gallery we share examples that match what you're planning. Tell us a little about your project and we'll send them your way.</p>
<ul style="margin: 8px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px">
<li style="display: flex; align-items: center; gap: 12px; font-size: 16px; color: #3A3A3F"><svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon></svg>Examples matched to your project type</li>
<li style="display: flex; align-items: center; gap: 12px; font-size: 16px; color: #3A3A3F"><svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon></svg>How each one was scoped, built and launched</li>
<li style="display: flex; align-items: center; gap: 12px; font-size: 16px; color: #3A3A3F"><svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon></svg>A short walkthrough call, if you'd like one</li>
</ul>
</div>
<div style="flex: 1 1 440px; background: #FFFFFF; border: 1px solid #E2E0D8; border-radius: 16px; padding: 36px; box-sizing: border-box">
<!-- TODO: point this form at the form service (e.g. Formspree) with action="..." method="POST" -->
<form id="portfolio-form" style="display: flex; flex-direction: column; gap: 20px">
<h3 style="margin: 0; font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 22px; font-weight: 800; letter-spacing: -0.5px">Request our portfolio</h3>
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="pf-name" style="font-size: 14px; font-weight: 600; color: #3A3A3F">Name</label>
<input id="pf-name" name="name" type="text" autocomplete="name" required style="width: 100%; box-sizing: border-box; min-height: 48px; padding: 12px 14px; border: 1px solid #CFCCC2; border-radius: 8px; background: #FFFFFF; color: #18181B; font-family: Inter, system-ui, sans-serif; font-size: 16px">
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="pf-email" style="font-size: 14px; font-weight: 600; color: #3A3A3F">Work email</label>
<input id="pf-email" name="email" type="email" autocomplete="email" required style="width: 100%; box-sizing: border-box; min-height: 48px; padding: 12px 14px; border: 1px solid #CFCCC2; border-radius: 8px; background: #FFFFFF; color: #18181B; font-family: Inter, system-ui, sans-serif; font-size: 16px">
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="pf-type" style="font-size: 14px; font-weight: 600; color: #3A3A3F">What are you planning?</label>
<select id="pf-type" name="type" style="width: 100%; box-sizing: border-box; min-height: 48px; padding: 12px 14px; border: 1px solid #CFCCC2; border-radius: 8px; background: #FFFFFF; color: #18181B; font-family: Inter, system-ui, sans-serif; font-size: 16px">
<option>A new website or redesign</option>
<option>An online store or Shopify app</option>
<option>A mobile app or custom software</option>
<option>AI or workflow automation</option>
<option>Cloud or IT consulting</option>
<option>Something else</option>
</select>
</div>
<div style="display: flex; flex-direction: column; gap: 8px">
<label for="pf-note" style="font-size: 14px; font-weight: 600; color: #3A3A3F">Anything else we should know? (optional)</label>
<textarea id="pf-note" name="note" rows="3" style="width: 100%; box-sizing: border-box; min-height: 48px; padding: 12px 14px; border: 1px solid #CFCCC2; border-radius: 8px; background: #FFFFFF; color: #18181B; font-family: Inter, system-ui, sans-serif; font-size: 16px; resize: vertical"></textarea>
</div>
<button type="submit" style="min-height: 52px; padding: 0 24px; border: 0; border-radius: 8px; background: #18181B; color: #F6F5F1; font-family: Inter, system-ui, sans-serif; font-size: 16px; font-weight: 600; cursor: pointer">Send me examples</button>
<p style="margin: 0; font-size: 13px; line-height: 1.5; color: #5F5E5A">We'll only use your details to reply about your project. See our <a href="privacy.html" style="color: #5F5E5A">privacy policy</a>.</p>
</form>
<div id="pf-thanks" role="status" tabindex="-1" hidden style="display: flex; flex-direction: column; gap: 16px; padding: 24px 0">
<svg viewBox="0 0 100 100" width="48" height="48" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="32,52 45,64 68,40" fill="none" stroke="#18181B" stroke-width="8" stroke-linecap="square"></polyline></svg>
