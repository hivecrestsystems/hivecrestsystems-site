<script is:inline>
(function () {
  // Typing line in the hero: cycles through phrases. Skipped for reduced motion.
  var el = document.getElementById('typed');
  var phrases = ['websites that sell.', 'apps people actually use.', 'automations that give you hours back.', 'cloud that grows with you.', 'IT that just works.'];
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduce) {
    var p = 0, n = phrases[0].length, dir = -1, hold = 36;
    setInterval(function () {
      if (hold > 0) { hold--; return; }
      if (dir === -1) {
        if (n > 0) { n--; } else { dir = 1; p = (p + 1) % phrases.length; hold = 4; }
      } else {
        if (n < phrases[p].length) { n++; } else { dir = -1; hold = 36; }
      }
      el.textContent = phrases[p].slice(0, n);
    }, 55);
  }

  // Portfolio request form. Currently only swaps to the thank-you state.
  // TODO: send the data to the form service before showing the thank-you message.
  var form = document.getElementById('portfolio-form');
  var thanks = document.getElementById('pf-thanks');
  var reset = document.getElementById('pf-reset');
  if (form && thanks) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      form.hidden = true;
      thanks.hidden = false;
      thanks.focus();
    });
  }
  if (reset && form && thanks) {
    reset.addEventListener('click', function () {
      form.reset();
      thanks.hidden = true;
      form.hidden = false;
    });
  }
})();
</script>
