---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHoneycomb from '../components/HeroHoneycomb.astro';
import SiteLogo from '../components/SiteLogo.astro';
import HeaderHeight from '../components/HeaderHeight.astro';
import { PROJECT_TYPES, TURNSTILE_ACTION, TURNSTILE_SITE_KEY } from '../data/portfolio-form';
import { SERVICES, homepageStructuredData } from '../data/seo';
import ContactFooter from '../components/ContactFooter.astro';

// Phrases typed after "$ hivecrest builds" in the hero.
const typedPhrases = [
  'websites that sell.',
  'apps people actually use.',
  'automations that give you hours back.',
  'cloud that grows with you.',
  'IT that just works.',
];
// The line is monospaced, so the phrase with the most characters is the widest.
const longestPhrase = typedPhrases.reduce((a, b) => (b.length > a.length ? b : a));

// Main links. The numbers match the section eyebrows and show in the phone menu.
const navLinks = [
  { href: '#services', label: 'Services', num: '01' },
  { href: '#work', label: 'Work', num: '03' },
  { href: '#government', label: 'Government', num: '04' },
  { href: '#about', label: 'About', num: '05' },
];

// Service cards; the same list feeds the structured data in src/data/seo.ts.
const services = SERVICES;

const steps = [
  { title: 'Discover', text: "We learn how your business runs and what's slowing it down." },
  { title: 'Design', text: 'We plan and prototype before writing code, while changes are still cheap.' },
  { title: 'Build', text: 'We ship in short cycles you can review and test as we go.' },
  { title: 'Run', text: "We host, monitor and keep improving what we've built together." },
];

const benefits = [
  'Examples matched to your project type',
  'How each one was scoped, built and launched',
  "A short walkthrough call, if you'd like one",
];

// The project types and Turnstile settings are shared with the Worker that receives the form.
const projectTypes = PROJECT_TYPES;

const govCodes = [
  { label: 'NAICS', lines: ['541511 Custom computer programming', '541512 Computer systems design', '541519 Other computer services'] },
  { label: 'PSC', lines: ['DA01 Application development'] },
  { label: 'UEI', lines: ['[PENDING SAM.GOV]'] },
  { label: 'CAGE', lines: ['[PENDING]'] },
];
---
<BaseLayout
  title="Hivecrest Systems | Software, web, cloud and IT consulting"
  description="Hivecrest Systems designs, builds and supports the websites, software, cloud and automation that businesses and public agencies run on."
  path="/"
>
<script type="application/ld+json" slot="head" set:html={JSON.stringify(homepageStructuredData())} />
<header class="site-header site-header--sticky">
<div class="container topbar topbar--menu">
<SiteLogo href="#top" />
<button type="button" id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="main-nav">
<svg class="menu-toggle__icon menu-toggle__icon--open" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
<svg class="menu-toggle__icon menu-toggle__icon--close" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
<span class="menu-toggle__label">Menu</span>
</button>
<nav id="main-nav" aria-label="Main" class="main-nav">
{navLinks.map((l) => (
<a href={l.href} class="main-nav__link">{l.label}<span class="main-nav__num" aria-hidden="true">{l.num}</span></a>
))}
<a href="#contact" class="btn btn--sm btn--honey main-nav__cta"><svg class="main-nav__cta-icon" viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#18181B"></polygon></svg>Book a call</a>
</nav>
</div>
</header>
<HeaderHeight />

<main id="main">
<section id="top" class="hero">
<div class="hero__stage">
<HeroHoneycomb />
<div class="container hero__inner">
<p class="eyebrow eyebrow--honey">IT SERVICES · IT CONSULTING</p>
<h1 class="hero__title"><span class="hero__title-line">Strong systems,</span> <span class="hero__title-line">built cell by cell.</span></h1>
<p aria-hidden="true" class="hero__terminal">
<span class="hero__terminal-line hero__terminal-sizer"><span class="hero__prompt">$</span> hivecrest builds <span class="hero__typed">{longestPhrase}</span><span class="hc-cursor"></span></span>
<span class="hero__terminal-line"><span class="hero__prompt">$</span> hivecrest builds <span id="typed" class="hero__typed" data-phrases={JSON.stringify(typedPhrases)}>{typedPhrases[0]}</span><span class="hc-cursor"></span></span>
</p>
<p class="hero__lede">Hivecrest Systems designs, builds and supports the websites, software, cloud and automation that businesses and public agencies run on.</p>
<div class="button-row">
<a href="#contact" class="btn btn--honey">Book a free consultation</a>
<a href="#services" class="btn btn--ghost-dark">See what we build</a>
</div>
</div>
</div>
</section>
<section id="services" class="container services">
<div class="section-head">
<p class="eyebrow">01 / SERVICES</p>
<h2 class="section-title">What we build and run</h2>
<p class="section-intro">From a first website to a full system, every piece is built to fit with the rest.</p>
</div>
<div class="service-grid">
{services.map((s) => (
<article class="service-card">
<svg viewBox="0 0 100 100" width="36" height="36" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="34,62 50,46 66,62" fill="none" stroke="#FFFFFF" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 class="item-title">{s.title}</h3>
<p class="service-card__text">{s.text}</p>
<p class="service-card__tags">{s.tags}</p>
</article>
))}
</div>
</section>

<section class="section-dark">
<div class="container process">
<div class="section-head">
<p class="eyebrow eyebrow--honey">02 / HOW WE WORK</p>
<h2 class="section-title">Small cells. Strong structure.</h2>
<p class="section-intro section-intro--on-dark">We work in short, visible steps, so you always know what's built, what's next and what it costs.</p>
</div>
<ol class="process-list">
{steps.map((step, i) => (
<li class="process-step">
<span class="process-step__num">{String(i + 1).padStart(2, '0')}</span>
<h3 class="item-title">{step.title}</h3>
<p class="process-step__text">{step.text}</p>
</li>
))}
</ol>
</div>
</section>

<section id="work" class="container work">
<div class="work__intro">
<p class="eyebrow">03 / WORK</p>
<h2 class="section-title">See work like yours</h2>
<p class="section-intro section-intro--narrow">Every project is built around one client's business, so instead of a generic gallery we share examples that match what you're planning. Tell us a little about your project and we'll send them your way.</p>
<ul class="benefit-list">
{benefits.map((b) => (
<li><svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon></svg>{b}</li>
))}
</ul>
</div>
<div class="form-card">
{/* Sent by the script below to the Worker at /api/portfolio (worker/portfolio.ts). */}
<form id="portfolio-form" class="form" action="/api/portfolio" method="post" data-turnstile-sitekey={TURNSTILE_SITE_KEY} data-turnstile-action={TURNSTILE_ACTION}>
<h3 class="card-title">Request our portfolio</h3>
<div class="field">
<label for="pf-name" class="field__label">Name</label>
<input id="pf-name" name="name" type="text" autocomplete="name" required maxlength="100" class="field__control">
</div>
<div class="field">
<label for="pf-email" class="field__label">Work email</label>
<input id="pf-email" name="email" type="email" autocomplete="email" required maxlength="254" class="field__control">
</div>
<div class="field">
<label for="pf-type" class="field__label">What are you planning?</label>
<select id="pf-type" name="type" class="field__control">
{projectTypes.map((t) => <option>{t}</option>)}
</select>
</div>
<div class="field">
<label for="pf-note" class="field__label">Anything else we should know? (optional)</label>
<textarea id="pf-note" name="note" rows="3" maxlength="2000" class="field__control"></textarea>
</div>
{/* Honeypot: hidden from people and screen readers, so anything typed here came from a bot. */}
<div class="form__trap" aria-hidden="true">
<label for="pf-website">Website</label>
<input id="pf-website" name="website" type="text" tabindex="-1" autocomplete="off">
</div>
{/* Cloudflare Turnstile. It stays invisible unless it needs the visitor to tick a box. */}
<div id="pf-turnstile" class="form__turnstile"></div>
<p id="pf-error" class="form__error" role="alert" hidden>Sorry, your request didn't send. Please try again, or email us at <a href="mailto:hello@hivecrestsystems.com">hello@hivecrestsystems.com</a>.</p>
<button type="submit" class="form__submit">Send me examples</button>
<p class="form__note">We'll only use your details to reply about your project. See our <a href="/privacy">privacy policy</a>.</p>
<noscript><p class="form__note">This form needs JavaScript. You can also email us at <a href="mailto:hello@hivecrestsystems.com">hello@hivecrestsystems.com</a>.</p></noscript>
</form>
<div id="pf-thanks" role="status" tabindex="-1" hidden class="form-thanks">
<svg viewBox="0 0 100 100" width="48" height="48" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#E39A2B"></polygon><polyline points="32,52 45,64 68,40" fill="none" stroke="#18181B" stroke-width="8" stroke-linecap="square"></polyline></svg>
<h3 class="card-title">Thanks, request received.</h3>
<p class="form-thanks__text">We'll reply with examples that match your project, and a time to talk if you'd like one.</p>
<button type="button" id="pf-reset" class="form-thanks__reset">Send another request</button>
</div>
</div>
</section>

<section id="government" class="section-sand">
<div class="container gov">
<div class="gov__intro">
<p class="eyebrow">04 / PUBLIC SECTOR</p>
<h2 class="section-title">Ready for government work</h2>
<p class="gov__text">A Maryland Company delivering Software Development and IT Services to Agencies and prime contractors. Teaming inquiries are welcome.</p>
<a href="#contact" class="btn btn--md btn--outline gov__cta">Capability statement [PDF coming soon]</a>
</div>
<dl class="gov-codes">
{govCodes.map((c) => (
<div class="gov-codes__item">
<dt>{c.label}</dt>
<dd>{c.lines.map((line, i) => <Fragment>{i > 0 && <br />}{line}</Fragment>)}</dd>
</div>
))}
</dl>
</div>
</section>

<section id="about" class="container about">
<div class="about__head">
<p class="eyebrow">05 / ABOUT</p>
<h2 class="section-title">One partner for the whole system</h2>
</div>
<div class="about__body">
<p>Hivecrest Systems is a Software and IT Services company. We design, build and support the technology that businesses and public agencies depend on, from a first website to cloud infrastructure.</p>
<p>We build the way a honeycomb does: small, solid pieces that fit together into one strong system. You get a team for the whole picture, plain answers on cost and timing, and support that continues after launch.</p>
</div>
</section>

{/* Phones and small tablets: shown once the hero buttons scroll away, hidden again at the footer. */}
<a href="#contact" id="float-cta" class="float-cta"><svg viewBox="0 0 100 100" width="18" height="18" aria-hidden="true"><polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="#18181B"></polygon></svg>Book a call</a>
</main>

<ContactFooter />

<script>
  // Phone menu: the Menu button shows and hides the main links (see .menu-toggle in site.css).
  const toggle = document.getElementById('menu-toggle');
  const nav = document.getElementById('main-nav');
  const topbar = toggle?.closest('.topbar');
  if (toggle && nav && topbar) {
    const label = toggle.querySelector('.menu-toggle__label');
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';
    const setOpen = (open: boolean) => {
      topbar.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
    };
    toggle.addEventListener('click', () => setOpen(!isOpen()));
    // Following a link, pressing Escape or tapping elsewhere closes the menu.
    nav.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (isOpen() && !topbar.contains(event.target as Node)) setOpen(false);
    });
  }

  // Floating "Book a call" on phones: visible between the hero buttons and the footer.
  const floatCta = document.getElementById('float-cta');
  const heroButtons = document.querySelector('.hero .button-row');
  const footer = document.getElementById('contact');
  if (floatCta && heroButtons && footer && 'IntersectionObserver' in window) {
    let pastHero = false;
    let atFooter = false;
    const update = () => floatCta.classList.toggle('is-visible', pastHero && !atFooter);
    // The buttons count as gone once they scroll under the sticky header.
    const headerHeight = document.querySelector<HTMLElement>('.site-header')?.offsetHeight ?? 0;
    new IntersectionObserver(
      ([entry]) => {
        pastHero = !entry.isIntersecting && entry.boundingClientRect.top < (entry.rootBounds?.top ?? 0);
        update();
      },
      { rootMargin: `-${headerHeight}px 0px 0px 0px` },
    ).observe(heroButtons);
    new IntersectionObserver(([entry]) => {
      atFooter = entry.isIntersecting;
      update();
    }).observe(footer);
  }

  // Typing line in the hero: cycles through phrases. Skipped for reduced motion.
  const typed = document.getElementById('typed');
  const phrases: string[] = JSON.parse(typed?.dataset.phrases ?? '[]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (typed && phrases.length > 0 && !reduceMotion) {
    let phrase = 0;
    let length = phrases[0].length;
    let direction = -1;
    let hold = 36;
    setInterval(() => {
      if (hold > 0) {
        hold--;
        return;
      }
      if (direction === -1) {
        if (length > 0) {
          length--;
        } else {
          direction = 1;
          phrase = (phrase + 1) % phrases.length;
          hold = 4;
        }
      } else if (length < phrases[phrase].length) {
        length++;
      } else {
        direction = -1;
        hold = 36;
      }
      typed.textContent = phrases[phrase].slice(0, length);
    }, 55);
  }

  // Portfolio request form: sends the request to the Worker at /api/portfolio, which
  // checks it and emails it to us. Turnstile (Cloudflare's bot check) loads the first
  // time someone clicks into the form and stays invisible unless it needs a tick.
  type Turnstile = {
    render(container: HTMLElement, options: Record<string, unknown>): string;
    reset(widgetId: string): void;
  };
  const form = document.getElementById('portfolio-form') as HTMLFormElement | null;
  const thanks = document.getElementById('pf-thanks');
  const reset = document.getElementById('pf-reset');
  const errorBox = document.getElementById('pf-error');
  const widgetBox = document.getElementById('pf-turnstile');
  const submitButton = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  if (form && thanks && errorBox && widgetBox && submitButton) {
    const buttonLabel = submitButton.textContent;
    let widgetId: string | undefined;
    let token = '';
    const waiting: ((value: string) => void)[] = [];
    let turnstileReady: Promise<Turnstile> | undefined;

    const setToken = (value: string) => {
      token = value;
      if (value) waiting.splice(0).forEach((resolve) => resolve(value));
    };

    const loadTurnstile = () =>
      (turnstileReady ??= new Promise<Turnstile>((resolve, reject) => {
        const w = window as unknown as Record<string, unknown>;
        w.onHivecrestTurnstile = () => resolve(w.turnstile as Turnstile);
        const script = document.createElement('script');
        script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=onHivecrestTurnstile';
        script.async = true;
        script.onerror = () => reject(new Error('Turnstile did not load'));
        document.head.append(script);
      }).then((turnstile) => {
        widgetId = turnstile.render(widgetBox, {
          sitekey: form.dataset.turnstileSitekey,
          action: form.dataset.turnstileAction,
          appearance: 'interaction-only',
          callback: setToken,
          'expired-callback': () => setToken(''),
          'error-callback': () => setToken(''),
        });
        return turnstile;
      }));

    // Waits for Turnstile's token; gives up after 30 seconds.
    const getToken = () =>
      token
        ? Promise.resolve(token)
        : new Promise<string>((resolve, reject) => {
            waiting.push(resolve);
            setTimeout(() => reject(new Error('Turnstile timed out')), 30_000);
          });

    form.addEventListener('focusin', () => loadTurnstile().catch(() => {}), { once: true });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorBox.hidden = true;
      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';
      form.setAttribute('aria-busy', 'true');
      let turnstile: Turnstile | undefined;
      try {
        turnstile = await loadTurnstile();
        const data = new FormData(form);
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            type: data.get('type'),
            note: data.get('note'),
            website: data.get('website'),
            token: await getToken(),
          }),
        });
        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        form.hidden = true;
        thanks.hidden = false;
        thanks.focus();
      } catch {
        errorBox.hidden = false;
      } finally {
        // Turnstile tokens work once, so get a fresh one for any next attempt.
        if (turnstile && widgetId) {
          setToken('');
          turnstile.reset(widgetId);
        }
        submitButton.disabled = false;
        submitButton.textContent = buttonLabel;
        form.removeAttribute('aria-busy');
      }
    });

    reset?.addEventListener('click', () => {
      form.reset();
      errorBox.hidden = true;
      thanks.hidden = true;
      form.hidden = false;
    });
  }
</script>
</BaseLayout>
