---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContactFooter from '../../components/ContactFooter.astro';
import { publishedGuides, guidePath, formatDate, readingMinutes, type Guide } from '../../data/guides';
import { ORGANIZATION_ID, SITE_URL } from '../../data/seo';

export async function getStaticPaths() {
  const guides = await publishedGuides();
  return guides.map((guide) => ({ params: { slug: guide.id }, props: { guide } }));
}

const { guide } = Astro.props as { guide: Guide };
const { Content } = await render(guide);
const { title, description, eyebrow, published, updated, cta } = guide.data;
// The box after the guide. Government guides point buyers to the codes and registration status.
const ctaBox = {
  project: {
    title: 'Planning a project like this?',
    text: "Tell us what you're working on. We'll send examples that match it and set up a free 30-minute call if you'd like one.",
    button: { href: '/#work', label: 'Request examples' },
  },
  government: {
    title: 'Buying for an agency or a prime contract?',
    text: 'See our NAICS and PSC codes and registration status, or email us about a requirement or a teaming opportunity.',
    button: { href: '/#government', label: 'Government details' },
  },
}[cta];
const url = `${SITE_URL}${guidePath(guide)}`;
// Search results cut titles off at about 60 characters, so long headlines go without the brand.
const pageTitle = `${title} | Hivecrest Systems`.length <= 70 ? `${title} | Hivecrest Systems` : title;
const meta = [
  `Published ${formatDate(published)}`,
  updated ? `Updated ${formatDate(updated)}` : null,
  `${readingMinutes(guide)} min read`,
].filter(Boolean).join(' · ');

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: title,
      description,
      url,
      mainEntityOfPage: url,
      datePublished: published.toISOString(),
      dateModified: (updated ?? published).toISOString(),
      author: { '@type': 'Organization', '@id': ORGANIZATION_ID, name: 'Hivecrest Systems' },
      publisher: { '@id': ORGANIZATION_ID },
      image: `${SITE_URL}/assets/og-image.png`,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
        { '@type': 'ListItem', position: 2, name: 'Guides', item: `${SITE_URL}/guides` },
        { '@type': 'ListItem', position: 3, name: title, item: url },
      ],
    },
  ],
};
---
<BaseLayout title={pageTitle} description={description} path={guidePath(guide)} ogType="article">
<script type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
<PageHeader book />

<main>
<PageIntro eyebrow={eyebrow} title={title} meta={meta} />
<div class="container article">
<nav aria-label="Breadcrumb" class="breadcrumb">
<a href="/guides">All guides</a>
</nav>
<article class="prose">
<Content />
</article>
<aside class="article-cta" aria-labelledby="article-cta-title">
<h2 id="article-cta-title" class="card-title">{ctaBox.title}</h2>
<p>{ctaBox.text}</p>
<div class="button-row">
<a href={ctaBox.button.href} class="btn btn--md btn--honey">{ctaBox.button.label}</a>
<a href="mailto:hello@hivecrestsystems.com" class="btn btn--md btn--outline">Email us</a>
</div>
</aside>
</div>
</main>

<ContactFooter current="guides" />
</BaseLayout>
