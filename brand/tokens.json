{
  "color": {
    "brand": {
      "charcoal": "#18181B",
      "honey": "#E39A2B",
      "paper": "#F6F5F1",
      "night": "#141416",
      "stone": "#5F5E5A"
    },
    "supporting": {
      "lightText": "#EDEBE4",
      "mutedOnDark": "#A3A29C",
      "softOnDark": "#C9C7BF",
      "bodyGray": "#3A3A3F",
      "cardBorder": "#E2E0D8",
      "sand": "#ECEAE3",
      "white": "#FFFFFF"
    }
  },
  "font": {
    "mono": { "family": "JetBrains Mono", "fallback": "ui-monospace, monospace", "weights": [500, 800], "use": "wordmark, headings, labels, data" },
    "sans": { "family": "Inter", "fallback": "system-ui, sans-serif", "weights": [400, 500, 600], "use": "body, buttons, forms" }
  },
  "radius": { "sm": "8px", "md": "12px", "lg": "16px" },
  "layout": { "maxWidth": "1200px" },
  "rules": [
    "Honey text only on dark backgrounds (7.5:1+). On light backgrounds use Honey for shapes and buttons with Charcoal text.",
    "Use the -on-dark logo files on Charcoal or Night."
  ]
}
